{
  "name": "beeftv-plugin-maas",
  "version": "1.0.0",
  "description": "内置 MaaS 网关渠道插件：只需填写 MaaS 的 sk-... 密钥，即可把网关上的文本、图像、视频与语音模型一键同步到 BeefTV 模型服务。",
  "type": "module",
  "main": "./client/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "beeftv-plugin",
    "maas",
    "newapi",
    "gateway",
    "text",
    "image",
    "video",
    "audio"
  ],
  "beeftv": {
    "name": "MaaS 算力网关",
    "client": "./client/index.js",
    "permissions": [
      "generation.run",
      "media.read",
      "ui.slot",
      "settings.write"
    ],
    "configuration": {
      "fields": [
        {
          "name": "apiKey",
          "type": "secret",
          "label": "MaaS API Key",
          "required": true,
          "description": "填写 MaaS 网关（https://maas.ovaijisuan.com）签发的 sk-... 密钥"
        },
        {
          "name": "baseUrl",
          "type": "string",
          "label": "Base URL",
          "required": false,
          "default": "https://maas.ovaijisuan.com/v1",
          "description": "默认即为 MaaS 网关官方地址，通常无需修改"
        }
      ]
    },
    "contributes": {}
  }
}
