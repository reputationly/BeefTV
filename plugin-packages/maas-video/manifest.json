{
  "apiVersion": "beeftv.plugin/v2",
  "id": "maas-video",
  "name": "MaaS 视频",
  "version": "1.0.0",
  "author": "BeefTV",
  "description": "MaaS（new-api）视频生成：POST /v1/videos + metadata.image_mode，异步轮询 /v1/videos/{id}。",
  "documentation": "# MaaS 视频接口字段\n\n- Provider ID：`maas-video`；能力：`video`；异步任务。\n- 创建：`POST /v1/videos`（JSON）；轮询：`GET /v1/videos/{id}`；取消：`DELETE /v1/videos/{id}`。\n\n| 统一字段 | 上游字段 |\n| --- | --- |\n| `model` | `model`（平台模型名，如 `minimax-h3-2k`） |\n| `prompt` | `prompt` |\n| `images` | `images`（首帧/尾帧/参考图，顺序即业务顺序） |\n| `duration` | `duration`（整数秒；续写时为最终总时长） |\n| `resolution` | `metadata.resolution`（`768P` / `2K`） |\n| `generateAudio` | `metadata.generate_audio` |\n| `providerOptions.maas.imageMode` | `metadata.image_mode`（`first-last-frame` / `text-to-video` / `video-extension` / `reference`） |\n\n轮询产物在 `metadata.url`；状态：`queued` / `in_progress` / `completed` / `failed` / `cancelled`。\n",
  "permissions": [],
  "configuration": {
    "fields": [
      {
        "name": "apiKey",
        "type": "secret",
        "required": true,
        "label": "API Key"
      },
      {
        "name": "baseUrl",
        "type": "string",
        "required": false,
        "label": "Base URL",
        "default": "https://maas.ovaijisuan.com"
      }
    ]
  },
  "contributes": {
    "providers": [
      {
        "id": "maas-video",
        "label": "MaaS 视频",
        "capabilities": [
          "video"
        ],
        "scopes": [
          "admin.system-channel",
          "user.custom-channel",
          "canvas",
          "creation",
          "agent"
        ],
        "baseUrl": "https://maas.ovaijisuan.com",
        "requiresPublicMediaUrls": false,
        "auth": {
          "type": "bearer",
          "field": "apiKey"
        },
        "parameters": [
          {
            "name": "model",
            "type": "string",
            "required": true,
            "mapping": "model"
          },
          {
            "name": "prompt",
            "type": "string",
            "required": true,
            "mapping": "prompt"
          },
          {
            "name": "images",
            "type": "media[]",
            "required": false,
            "mapping": "images"
          },
          {
            "name": "duration",
            "type": "integer",
            "required": false,
            "mapping": "duration"
          },
          {
            "name": "resolution",
            "type": "string",
            "required": false,
            "mapping": "metadata.resolution"
          },
          {
            "name": "generateAudio",
            "type": "boolean",
            "required": false,
            "mapping": "metadata.generate_audio"
          },
          {
            "name": "providerOptions",
            "type": "object",
            "required": false,
            "mapping": "metadata.image_mode"
          }
        ],
        "create": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "application/json",
          "body": {
            "model": {
              "$ref": "request.model"
            },
            "prompt": {
              "$ref": "request.prompt"
            },
            "duration": {
              "$omitEmpty": {
                "$ref": "request.duration"
              }
            },
            "images": {
              "$omitEmpty": {
                "$map": {
                  "from": {
                    "$sortByOrder": {
                      "$ref": "request.images"
                    }
                  },
                  "as": "media",
                  "in": {
                    "$ref": "media.value"
                  }
                }
              }
            },
            "metadata": {
              "image_mode": {
                "$if": {
                  "condition": {
                    "$gt": [
                      {
                        "$len": {
                          "$ref": "request.images"
                        }
                      },
                      0
                    ]
                  },
                  "then": "first-last-frame",
                  "else": "text-to-video"
                }
              },
              "resolution": {
                "$omitEmpty": {
                  "$ref": "request.resolution"
                }
              },
              "generate_audio": {
                "$omitEmpty": {
                  "$ref": "request.generateAudio"
                }
              }
            }
          }
        },
        "poll": {
          "method": "GET",
          "path": "/v1/videos/{{taskId}}"
        },
        "response": {
          "taskId": {
            "$coalesce": [
              {
                "$ref": "response.id"
              },
              {
                "$ref": "response.task_id"
              },
              {
                "$ref": "taskId"
              }
            ]
          },
          "status": {
            "$coalesce": [
              {
                "$ref": "response.status"
              },
              "queued"
            ]
          },
          "message": {
            "$coalesce": [
              {
                "$ref": "response.error.message"
              },
              {
                "$ref": "response.message"
              }
            ]
          },
          "videos": {
            "$coalesce": [
              {
                "$ref": "response.metadata.url"
              },
              {
                "$ref": "response.url"
              }
            ]
          },
          "errorPaths": [
            "error.code"
          ],
          "messagePaths": [
            "error.message"
          ]
        }
      },
      {
        "id": "maas-video-ref",
        "label": "MaaS 视频（参考族）",
        "capabilities": [
          "video"
        ],
        "scopes": [
          "admin.system-channel",
          "user.custom-channel",
          "canvas",
          "creation",
          "agent"
        ],
        "baseUrl": "https://maas.ovaijisuan.com",
        "requiresPublicMediaUrls": false,
        "auth": {
          "type": "bearer",
          "field": "apiKey"
        },
        "parameters": [
          {
            "name": "model",
            "type": "string",
            "required": true,
            "mapping": "model"
          },
          {
            "name": "prompt",
            "type": "string",
            "required": true,
            "mapping": "prompt"
          },
          {
            "name": "images",
            "type": "media[]",
            "required": false,
            "mapping": "images"
          },
          {
            "name": "duration",
            "type": "integer",
            "required": false,
            "mapping": "duration"
          },
          {
            "name": "resolution",
            "type": "string",
            "required": false,
            "mapping": "metadata.resolution"
          },
          {
            "name": "generateAudio",
            "type": "boolean",
            "required": false,
            "mapping": "metadata.generate_audio"
          },
          {
            "name": "providerOptions",
            "type": "object",
            "required": false,
            "mapping": "metadata.image_mode(reference)"
          }
        ],
        "create": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "application/json",
          "body": {
            "model": {
              "$ref": "request.model"
            },
            "prompt": {
              "$ref": "request.prompt"
            },
            "duration": {
              "$omitEmpty": {
                "$ref": "request.duration"
              }
            },
            "images": {
              "$omitEmpty": {
                "$map": {
                  "from": {
                    "$sortByOrder": {
                      "$ref": "request.images"
                    }
                  },
                  "as": "media",
                  "in": {
                    "$ref": "media.value"
                  }
                }
              }
            },
            "metadata": {
              "image_mode": "reference",
              "resolution": {
                "$omitEmpty": {
                  "$ref": "request.resolution"
                }
              },
              "generate_audio": {
                "$omitEmpty": {
                  "$ref": "request.generateAudio"
                }
              }
            }
          }
        },
        "poll": {
          "method": "GET",
          "path": "/v1/videos/{{taskId}}"
        },
        "response": {
          "taskId": {
            "$coalesce": [
              {
                "$ref": "response.id"
              },
              {
                "$ref": "response.task_id"
              },
              {
                "$ref": "taskId"
              }
            ]
          },
          "status": {
            "$coalesce": [
              {
                "$ref": "response.status"
              },
              "queued"
            ]
          },
          "message": {
            "$coalesce": [
              {
                "$ref": "response.error.message"
              },
              {
                "$ref": "response.message"
              }
            ]
          },
          "videos": {
            "$coalesce": [
              {
                "$ref": "response.metadata.url"
              },
              {
                "$ref": "response.url"
              }
            ]
          },
          "errorPaths": [
            "error.code"
          ],
          "messagePaths": [
            "error.message"
          ]
        }
      }
    ]
  }
}
